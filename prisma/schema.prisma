generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


// ─── Auth ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid()) @map("_id")
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  bio           String?
  country       String?
  totalXp       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── Study habits ──
  dailyGoalXp     Int     @default(30)
  reminderEnabled Boolean @default(true)
  /** Hour of day (0-23, learner's local time) to send the daily reminder */
  reminderHour    Int     @default(20)
  /** Minutes offset from UTC, e.g. Vietnam = 420 */
  utcOffsetMin    Int     @default(420)
  lastReminderAt  DateTime?

  accounts             Account[]
  sessions             Session[]
  placementTests       PlacementTest[]
  roadmaps             Roadmap[]
  lessonProgress       LessonProgress[]
  streaks              Streak[]
  userAchievements     UserAchievement[]
  friendsInitiated     Friendship[]       @relation("FriendInitiator")
  friendsReceived      Friendship[]       @relation("FriendReceiver")
  studyGroupMembers         StudyGroupMember[]
  studyGroupMessages        StudyGroupMessage[]
  studyGroupInvitesSent     StudyGroupInvite[] @relation("InviteSent")
  studyGroupInvitesReceived StudyGroupInvite[] @relation("InviteReceived")
  streakGiftsSent      StreakGift[]       @relation("GiftSender")
  streakGiftsReceived  StreakGift[]       @relation("GiftReceiver")
  notifications        Notification[]
  quizParticipants     QuizParticipant[]
  quizAnswers          QuizAnswer[]
  quizAttempts         QuizAttempt[]
  vocabularyItems      VocabularyItem[]
  avatar               UserAvatar?
  cramPlans            CramPlan[]
}

// ─── Avatar ──────────────────────────────────────────────────────────────────
// Stored in its own collection: a base64 image on User made every session lookup
// drag megabytes across the wire.

model UserAvatar {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @unique
  mimeType  String
  data      String   // base64 payload, no data: prefix
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Per-question attempt log ────────────────────────────────────────────────
// Feeds the weakness report and the spaced-repetition queue.

model QuizAttempt {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  language      String
  /** lesson | checkpoint | review | placement */
  source        String
  lessonId      String?
  lessonType    String?
  level         String?
  topic         String?
  question      String
  options       String[]
  correctAnswer Int
  chosenAnswer  Int      // -1 = bỏ qua
  isCorrect     Boolean
  explanation   String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, language, createdAt])
  @@index([userId, isCorrect])
}

// ─── Personal vocabulary notebook (SM-2 spaced repetition) ───────────────────

model VocabularyItem {
  id         String    @id @default(cuid()) @map("_id")
  userId     String
  language   String
  word       String
  phonetic   String?
  meaning    String
  example    String?
  exampleVi  String?
  sourceType String?   // lesson | manual | wrong_answer
  sourceId   String?

  // SM-2 state
  ease        Float    @default(2.5)
  intervalDay Int      @default(0)
  repetitions Int      @default(0)
  lapses      Int      @default(0)
  dueAt       DateTime @default(now())
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language, word])
  @@index([userId, language, dueAt])
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Placement Test ──────────────────────────────────────────────────────────

model PlacementTest {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  language    String
  testType    String   @default("cefr")
  level       String
  score       Int
  answers     String
  completedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap Roadmap?
}

// ─── Roadmap ─────────────────────────────────────────────────────────────────

model Roadmap {
  id              String    @id @default(cuid()) @map("_id")
  userId          String
  language        String
  targetExam      String?
  targetScore     Int?
  currentLevel    String
  targetLevel     String
  startDate       DateTime  @default(now())
  targetDate      DateTime
  weeklyHours     Int       @default(7)
  busyDays        Int[]     @default([])
  status          String    @default("active")
  totalWeeks      Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  learningFocus   String    @default("comprehensive")
  // "native" = học cả chữ viết bản địa; "romanized" = chỉ giao tiếp, dùng phiên âm Latin
  scriptMode      String?

  placementTestId String        @unique
  placementTest   PlacementTest @relation(fields: [placementTestId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeks           RoadmapWeek[]
}

model RoadmapWeek {
  id         String   @id @default(cuid()) @map("_id")
  roadmapId  String
  weekNumber Int
  theme      String
  skills     String
  status     String   @default("pending")
  startDate  DateTime

  roadmap Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  days    RoadmapDay[]
}

model RoadmapDay {
  id            String    @id @default(cuid()) @map("_id")
  weekId        String
  dayNumber     Int
  lessonType    String
  lessonId      String?
  scheduledDate DateTime?
  status        String    @default("pending")
  completedAt   DateTime?

  week   RoadmapWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  lesson Lesson?     @relation(fields: [lessonId], references: [id])
}

// ─── Lessons ─────────────────────────────────────────────────────────────────

model Lesson {
  id          String   @id @map("_id")
  language    String
  type        String
  level       String
  title       String
  description String?
  content     String
  duration    Int      @default(15)
  xpReward    Int      @default(10)
  createdAt   DateTime @default(now())

  roadmapDays    RoadmapDay[]
  lessonProgress LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  lessonId    String
  score       Int?
  timeSpent   Int?
  attempts    Int      @default(1)
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ─── Streaks ─────────────────────────────────────────────────────────────────

model Streak {
  id               String    @id @default(cuid()) @map("_id")
  userId           String
  language         String
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  frozenUntil      DateTime?
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
}

model StreakGift {
  id         String   @id @default(cuid()) @map("_id")
  senderId   String
  receiverId String
  language   String
  message    String?
  sentAt     DateTime @default(now())

  sender   User @relation("GiftSender",   fields: [senderId],   references: [id])
  receiver User @relation("GiftReceiver", fields: [receiverId], references: [id])
}

// ─── Achievements ────────────────────────────────────────────────────────────

model Achievement {
  id          String @id @default(cuid()) @map("_id")
  code        String @unique
  name        String
  description String
  icon        String
  category    String
  xpReward    Int    @default(50)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  achievementId String
  language      String?
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

// ─── Social ──────────────────────────────────────────────────────────────────

model Friendship {
  id          String   @id @default(cuid()) @map("_id")
  initiatorId String
  receiverId  String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  initiator User @relation("FriendInitiator", fields: [initiatorId], references: [id])
  receiver  User @relation("FriendReceiver",  fields: [receiverId],  references: [id])

  @@unique([initiatorId, receiverId])
}

model StudyGroup {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  description String?
  language    String
  maxMembers  Int      @default(10)
  createdById String
  createdAt   DateTime @default(now())

  members      StudyGroupMember[]
  messages     StudyGroupMessage[]
  invites      StudyGroupInvite[]
  quizSessions QuizSession[]
}

model StudyGroupMember {
  id       String   @id @default(cuid()) @map("_id")
  groupId  String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model StudyGroupMessage {
  id        String   @id @default(cuid()) @map("_id")
  groupId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyGroupInvite {
  id        String   @id @default(cuid()) @map("_id")
  groupId   String
  inviterId String
  inviteeId String
  // pending_admin | pending_invitee | accepted | rejected
  status    String   @default("pending_admin")
  createdAt DateTime @default(now())

  group   StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User       @relation("InviteSent",     fields: [inviterId], references: [id])
  invitee User       @relation("InviteReceived", fields: [inviteeId], references: [id])
}

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Exam Question Bank ───────────────────────────────────────────────────────

model ExamQuestion {
  id           String   @id @default(cuid()) @map("_id")
  exam         String   // TOEIC | IELTS
  part         String   // Part 5 | Part 6 | Part 7 | Listening Part 1-4
  type         String   // grammar | vocabulary | reading | listening
  level        String   // A2 | B1 | B2 | C1
  question     String
  options      String[]
  answer       Int      // 0-3 index
  explanation  String?
  source       String?  // e.g. "ETS TOEIC 2024 Test 1"
  grammarPoint String?  // snake_case tag for quiz matching: "passive_voice", "present_perfect"
  tags         String[] @default([])
  passage      String?  // full passage text for Part 6/7 reading questions
  createdAt    DateTime @default(now())
}

// ─── Review / Ôn tập ─────────────────────────────────────────────────────────

model ReviewSet {
  id          String   @id @default(cuid()) @map("_id")
  language    String   // english | thai | korean
  // vocabulary | grammar | quiz_15 | quiz_30 | simulation_b1 | simulation_toeic
  type        String
  topic       String   // e.g. "travel", "past_simple", "random_vocab"
  level       String   // A1 | A2 | B1 | B2 | C1
  title       String
  description String?
  duration    Int      // phút (15 hoặc 30)
  createdAt   DateTime @default(now())

  questions    ReviewQuestion[]
  quizSessions QuizSession[]
}

model ReviewQuestion {
  id          String   @id @default(cuid()) @map("_id")
  reviewSetId String
  order       Int
  question    String
  options     String[] // 4 lựa chọn
  answer      Int      // index đáp án đúng (0-3)
  explanation String?
  /** Song song với options: vì sao từng phương án sai ("" ở vị trí đáp án đúng) */
  whyWrong    String[] @default([])

  reviewSet ReviewSet @relation(fields: [reviewSetId], references: [id], onDelete: Cascade)
}

// ─── Cram Plan / Kế hoạch cấp tốc ────────────────────────────────────────────
// Short-horizon (hours to ~2 days), goal-driven study plan — deliberately separate
// from Roadmap (week-granularity, requires a completed PlacementTest first, driven by
// large week-theme banks). A cram plan needs neither: block durations are computed
// deterministically from however much time the learner actually has right now.

model CramPlan {
  id           String    @id @default(cuid()) @map("_id")
  userId       String
  language     String    // english | thai | korean
  goalType     String    // exam | upcoming_need | skill_push
  goalLabel    String    // "VSTEP B1", "Phỏng vấn xin việc", ...
  examType     String?   // VSTEP | TOEIC | IELTS | TOPIK | CUTFL | null
  level        String
  skills       String[]  // subset of vocabulary|grammar|reading|listening|speaking|writing|conversation
  targetAt     DateTime
  totalMinutes Int
  status       String    @default("active") // active | done — recomputed on every block PATCH
  introBlurb   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks CramBlock[]

  @@index([userId, status])
}

model CramBlock {
  id             String    @id @default(cuid()) @map("_id")
  planId         String
  order          Int
  skill          String
  title          String
  goalText       String
  durationMin    Int
  checklist      String[]
  // Parallel to checklist. A block is "done" when every item here is true and the
  // checklist is non-empty — info-only blocks (e.g. "Ngủ") have an empty checklist and
  // never count toward progress.
  checklistDone  Boolean[] @default([])
  template       String?   // markdown: mẫu câu / khung bài / kỹ thuật
  linkType       String    // lesson | conversation | review | none
  linkLessonType String?   // set when linkType = "lesson"
  linkTopic      String?   // free text, passed straight into generateLesson()'s topic param
  linkExamType   String?
  linkScenario   String?   // conversation scenario id, when linkType = "conversation"

  plan CramPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, order])
}

// ─── Group Quiz ───────────────────────────────────────────────────────────────

model QuizSession {
  id              String    @id @default(cuid()) @map("_id")
  groupId         String
  reviewSetId     String
  createdById     String
  // waiting | active | finished
  status          String    @default("waiting")
  currentQuestion Int       @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  group        StudyGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reviewSet    ReviewSet         @relation(fields: [reviewSetId], references: [id])
  participants QuizParticipant[]
  answers      QuizAnswer[]
}

model QuizParticipant {
  id        String   @id @default(cuid()) @map("_id")
  sessionId String
  userId    String
  score     Int      @default(0)
  joinedAt  DateTime @default(now())

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

model QuizAnswer {
  id            String   @id @default(cuid()) @map("_id")
  sessionId     String
  userId        String
  questionIndex Int
  answer        Int      // index đáp án user chọn
  isCorrect     Boolean
  answeredAt    DateTime @default(now())

  session QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId, questionIndex])
}
